# Copy to .env.local for local development:

#   cp .env.example .env.local

#

# Server-only variables (never exposed to the browser).



# FastAPI base URL (Next.js route handlers proxy to this).

BACKEND_URL=http://localhost:8000



# JWT RS256 private key (PEM). Generate with: bash generate-jwt-keys.sh

# BACKEND_JWT_PRIVATE_KEY=

# BACKEND_JWT_ISSUER=repif-frontend

# BACKEND_JWT_AUDIENCE=repif-backend

# BACKEND_JWT_TTL_SECONDS=300



# Umami analytics (optional — baked into the client bundle at build time).

# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js

# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
