# DB credentials
POSTGRES_USER=xxxxxx
POSTGRES_PASSWORD=xxxxxxx
POSTGRES_DB=xxxxxxx
DATABASE_URL=postgresql://xxxxxx:xxxxxxxx@localhost:5432/xxxxxxx

# JWT RS256 public key (PEM) — verify tokens from Next.js. Generate: bash generate-jwt-keys.sh
# BACKEND_JWT_PUBLIC_KEY=
# BACKEND_JWT_ISSUER=repif-frontend
# BACKEND_JWT_AUDIENCE=repif-backend

# Swagger at /docs — false in production (Coolify)
# ENABLE_DOCS=false
