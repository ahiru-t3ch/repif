# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=immo
DATABASE_URL=postgresql://app:changeme@db:5432/immo

# JWT RS256 — stored here for Compose substitution; each service receives only its key.
# Private key → frontend only (signs JWT). Public key → backend only (verifies JWT).
# BACKEND_JWT_PRIVATE_KEY=
# BACKEND_JWT_PUBLIC_KEY=
# BACKEND_JWT_ISSUER=repif-frontend
# BACKEND_JWT_AUDIENCE=repif-backend
# BACKEND_JWT_TTL_SECONDS=300

# Swagger UI at /docs — true for local dev, false on Coolify prod
ENABLE_DOCS=true
